# SQLite local (si DATABASE_URL está vacío)
DATABASE_PATH=instance/cpstore.sqlite
# Generar una clave privada. Nunca publicar el archivo .env.
SECRET_KEY=
# PostgreSQL: pegar aquí la URL EXTERNA de Render únicamente en .env.
# En el servicio web Render se usará la URL INTERNA.
DATABASE_URL=
# true solo al servir la aplicación por HTTPS (Render).
SESSION_COOKIE_SECURE=false
