# SQLite local (si DATABASE_URL está vacío)
DATABASE_PATH=instance/cpstore.sqlite
# Generar una clave privada. Nunca publicar el archivo .env.
SECRET_KEY=
# PostgreSQL: pegar aquí la URL EXTERNA de Render únicamente en .env.
# En el servicio web Render se usará la URL INTERNA.
DATABASE_URL=
# true solo al servir la aplicación por HTTPS (Render).
SESSION_COOKIE_SECURE=false

# Configuración local. En Render configurar las variables del servicio web.
APP_ENV=development
TRUST_PROXY=false
# Dominio exacto de producción, solo si no se usa RENDER_EXTERNAL_HOSTNAME.
APP_ALLOWED_HOSTS=
# Localmente permite archivos. En Render Free: false (disco efímero).
UPLOADS_ENABLED=true
PERSISTENT_INSTANCE=false
# Con disco persistente real: INSTANCE_PATH=/var/data/cpstore

# Sesión: cerrar tras 30 minutos sin actividad (configurable en el entorno).
SESSION_IDLE_MINUTES=30
